{
  "name": "raycoll-firestore-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "node stop-stale-emulators.mjs",
    "test": "firebase emulators:exec --config ../../firebase.test.json --only firestore,auth --project demo-raycoll \"node --test firestore.test.mjs\"",
    "posttest": "node stop-stale-emulators.mjs",
    "pretest:android": "node stop-stale-emulators.mjs",
    "test:android": "firebase emulators:exec --config ../../firebase.test.json --only firestore,auth --project demo-raycoll \"node run-android-tests.mjs\"",
    "posttest:android": "node stop-stale-emulators.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.0.0",
    "firebase-tools": "15.34.0"
  }
}
