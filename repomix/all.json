{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix/out/all.xml",
    "style": "xml",
    "compress": false,
    "headerText": "Całe repozytorium RayColl w jednej paczce: konfiguracja, reguły Firestore, kod aplikacji, zasoby, testy (Kotlin i Node), plany w docs/ oraz skrypty repomix. Stos: Kotlin, Jetpack Compose (Material 3), Hilt, Cloud Firestore jako jedyne źródło danych z pamięcią podręczną na telefonie (praca offline), Firebase Auth (konto gościa albo Google), Media3, minSdk 33, Gradle na Javie 21. Room i własna synchronizacja zostały usunięte. Zawartość odpowiada bieżącemu stanowi katalogu roboczego (także niezacommitowanym zmianom); pliki lokalne (klucze, local.properties) są pominięte.",
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false,
    "includeEmptyDirectories": false,
    "git": {
      "sortByChanges": true,
      "includeDiffs": false,
      "includeLogs": false
    }
  },
  "include": [
    "README.md",
    ".editorconfig",
    ".gitattributes",
    ".gitignore",
    "build.gradle.kts",
    "settings.gradle.kts",
    "gradle.properties",
    "gradle/libs.versions.toml",
    "gradle/gradle-daemon-jvm.properties",
    "gradle/wrapper/gradle-wrapper.properties",
    "gradlew",
    "gradlew.bat",
    "firebase.json",
    "firebase.test.json",
    "firestore.rules",
    "app/build.gradle.kts",
    "app/proguard-rules.pro",
    "app/src/main/AndroidManifest.xml",
    "docs/*.md",
    "app/src/main/java/com/raycoll/app/*.kt",
    "app/src/main/java/com/raycoll/app/core/**/*.kt",
    "app/src/main/java/com/raycoll/app/data/**/*.kt",
    "app/src/main/java/com/raycoll/app/domain/**/*.kt",
    "app/src/main/java/com/raycoll/app/di/**/*.kt",
    "app/src/main/java/com/raycoll/app/playback/**/*.kt",
    "app/src/main/java/com/raycoll/app/ui/**/*.kt",
    "app/src/main/res/**/*.xml",
    "app/src/main/res/**/*.properties",
    "app/src/debug/res/**/*.xml",
    "app/src/test/**/*.kt",
    "app/src/test/resources/**/*.properties",
    "tools/firestore-tests/*.mjs",
    "tools/firestore-tests/package.json",
    "repomix/pack.ps1",
    "repomix/*.json"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/build/**",
      "**/.gradle/**",
      "**/.kotlin/**",
      "**/node_modules/**",
      "**/package-lock.json",
      "local.properties",
      "**/google-services.json",
      "repomix/out/**"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
