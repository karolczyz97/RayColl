{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-full-part1-logic.xml",
    "style": "xml",
    "filePathStyle": "target-relative",
    "compress": false,
    "headerText": "RayColl - Część 1/3 (Architektura & Logika): Konfiguracja projektu, Gradle, manifest, moduły Core, Data (Room, Repozytoria, Sync), Domain (SRS, SessionEngine, Importy, Reguły) i Dependency Injection (DI).",
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false,
    "includeEmptyDirectories": false
  },
  "include": [
    "README.md",
    ".editorconfig",
    ".gitignore",
    "build.gradle.kts",
    "settings.gradle.kts",
    "gradle.properties",
    "gradle/libs.versions.toml",
    "gradle/wrapper/gradle-wrapper.properties",
    "gradlew",
    "gradlew.bat",
    "app/build.gradle.kts",
    "app/proguard-rules.pro",
    "app/src/main/AndroidManifest.xml",
    "app/src/main/java/com/raycoll/app/*.kt",
    "app/src/main/java/com/raycoll/app/core/**/*.kt",
    "app/src/main/java/com/raycoll/app/data/**/*.kt",
    "app/src/main/java/com/raycoll/app/domain/**/*.kt",
    "app/src/main/java/com/raycoll/app/di/**/*.kt"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".agents/**",
      "plan_*.txt",
      "konkluzje_*.txt",
      "**/build/**",
      "**/.gradle/**",
      "**/.kotlin/**",
      "local.properties",
      "**/google-services.json",
      "repomix*.xml"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
